<button type="button" class="ee-chat-btn" id="eeChatBtn" aria-label="Open chat help" aria-expanded="false" aria-controls="eeChatPanel">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.2 0-2.3-.2-3.4-.7L3 21l1.3-5.1A8.5 8.5 0 1 1 21 12Z" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M8.5 11.5h7M8.5 14.5h4.5" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>
</button>
<div class="ee-chat-panel" id="eeChatPanel" role="dialog" aria-label="North Fork help chat" aria-hidden="true">
  <div class="ee-chat-head">
    <div class="av" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.2 0-2.3-.2-3.4-.7L3 21l1.3-5.1A8.5 8.5 0 1 1 21 12Z" stroke="#fff" stroke-width="2"/></svg></div>
    <div><b>North Fork Help</b><span>Ask about services, emergencies, or booking</span></div>
    <button type="button" class="ee-chat-close" id="eeChatClose" aria-label="Close chat">&times;</button>
  </div>
  <div class="ee-chat-msgs" id="eeChatMsgs" aria-live="polite"></div>
  <div class="ee-chips" id="eeChatChips"></div>
  <form class="ee-chat-input" id="eeChatForm" autocomplete="off">
    <input id="eeChatInput" type="text" placeholder="Type your question…" maxlength="400" aria-label="Message">
    <button type="submit">Send</button>
  </form>
</div>
