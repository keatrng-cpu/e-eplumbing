# Ellingson Plumbing — environment variables.
# Copy to .env for local work, and set the same keys in
# Netlify → Site settings → Environment variables for production.
# Every value here is intentionally empty. Never commit a filled-in .env.

# --- Dispatch notifications (netlify/functions/submission-created.js) ---
# Slack / Zapier / Make incoming webhook. Unset = the ticket is logged only.
NOTIFY_WEBHOOK=
# Informational; Netlify's own UI sends the notification email.
NOTIFY_EMAIL=
# Twilio: all four are required before any SMS is sent.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Comma-separated E.164 numbers for the on-call plumber(s), e.g. +12187792553
DISPATCH_SMS=

# --- Home Team Plan checkout (netlify/functions/checkout.js) ---
# Secret key. Server-side only — never expose this to the browser.
STRIPE_SECRET_KEY=
# Price IDs created in the Stripe dashboard. The amounts live in Stripe, not
# in this repo, so $29/mo and $279/yr have exactly one source of truth.
STRIPE_PRICE_HTP_MONTHLY=
STRIPE_PRICE_HTP_YEARLY=

# --- Calendar (netlify/functions/book.js, availability.js) ---
# Both must be set to switch off the Netlify Blobs fallback and use the
# atomic Postgres holds in supabase/001_schedule.sql.
# The service-role key bypasses RLS: server-side only, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics ---
# No key needed here: the PostHog project token in analytics.js is a
# publishable client key, which is designed to ship in the page source.
